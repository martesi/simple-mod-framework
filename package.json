{
  "name": "simple-mod-framework",
  "version": "0.1.0",
  "private": true,
  "description": "A mod framework for HITMAN 3 that allows the automatic synthesis of mods from source files. Ships as a single Electron app (React 19 + shadcn/ui on Base UI) with the framework core (deploy/discover/analyse - src/main/core) embedded in-process, no separate CLI. Talks to the host process through the SmfApi contract in src/renderer/src/lib/ipc.ts, backed by real ipcMain.handle channels - fs/child_process live only in src/main, never the renderer.",
  "main": "./out/main/index.cjs",
  "type": "module",
  "author": "Atampy26",
  "license": "LGPL-3.0-only",
  "scripts": {
    "postinstall": "bun scripts/setup.ts --postinstall",
    "setup": "bun scripts/setup.ts",
    "fetch:hashes": "bun scripts/fetch-hashes.ts",
    "dev": "electron-vite dev",
    "dev:remote": "electron-vite dev -- --remote-debugging-port=9222 --remote-allow-origins=\"*\"",
    "fetch:win-electron": "bun scripts/fetch-win-electron.ts",
    "test:unit": "bun test",
    "test:cache-version": "node tests/cache-version/run.js",
    "test:typescript-compile": "node tests/typescript-compile/run.js",
    "test:game-detection": "node tests/game-detection/run.js",
    "dev:win": "bun scripts/fetch-win-electron.ts && WSLENV=\"${WSLENV:+$WSLENV:}ELECTRON_RENDERER_URL\" NO_SANDBOX=1 ELECTRON_EXEC_PATH=.win-electron-dev/electron.exe electron-vite dev",
    "build": "bun run typecheck && electron-vite build",
    "build:win": "bun run typecheck && electron-vite build && electron-builder --win --dir",
    "dist:win": "bun run typecheck && electron-vite build && electron-builder --win",
    "test": "bun run test:unit && bun run test:cache-version && bun run test:typescript-compile && bun run test:game-detection",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "lint": "eslint .",
    "i18n:extract": "lingui extract"
  },
  "dependencies": {
    "@fancyapps/ui": "^6.1.14",
    "esbuild": "^0.28.1",
    "fp-ts": "^2.16.11"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@eslint/js": "^10.0.1",
    "@lingui/babel-plugin-lingui-macro": "^6.6.0",
    "@lingui/cli": "^6.6.0",
    "@lingui/core": "^6.6.0",
    "@lingui/react": "^6.6.0",
    "@lingui/vite-plugin": "^6.6.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/fs-extra": "^11.0.4",
    "@types/klaw": "^3.0.7",
    "@types/lodash.mergewith": "^4.6.7",
    "@types/lossless-json": "^1.0.1",
    "@types/md5": "^2.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/semver": "^7.8.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "check-disk-space": "^3.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crc": "^4.3.2",
    "decimal.js": "^10.3.1",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-log": "^5.4.4",
    "electron-vite": "6.0.0-beta.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "filtrex": "^3.1.0",
    "fs-extra": "^11.4.0",
    "hash-wasm": "^4.12.0",
    "json5": "^2.2.3",
    "klaw": "^4.1.0",
    "lodash.isequal": "^4.5.0",
    "lodash.mergewith": "^4.6.2",
    "lossless-json": "^1.0.5",
    "lucide-react": "^1.28.0",
    "md5": "^2.3.0",
    "postcss": "^8.5.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.2",
    "rfc6902": "^5.0.1",
    "semver": "^7.8.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.185.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "zustand": "^5.0.3"
  }
}
