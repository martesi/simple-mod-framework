{
  "name": "simple-mod-framework",
  "version": "0.1.0",
  "private": true,
  "description": "A mod framework for HITMAN 3 that allows the automatic synthesis of mods from source files. Ships as a single Electron app (React 19 + shadcn/ui on Base UI) with the framework core (deploy/discover/analyse - src/main/core) embedded in-process, no separate CLI. Talks to the host process through the SmfApi contract in src/renderer/src/lib/ipc.ts, backed by real ipcMain.handle channels - fs/child_process live only in src/main, never the renderer.",
  "main": "./out/main/index.cjs",
  "type": "module",
  "author": "Atampy26",
  "license": "LGPL-3.0-only",
  "scripts": {
    "postinstall": "node scripts/setup.js --postinstall",
    "setup": "node scripts/setup.js",
    "fetch:hashes": "node scripts/fetch-hashes.js",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "npm run typecheck && electron-vite build && electron-builder --win --dir",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "lint": "eslint ."
  },
  "dependencies": {
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^9.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/fs-extra": "^9.0.13",
    "@types/klaw": "^3.0.7",
    "@types/lodash.mergewith": "^4.6.7",
    "@types/lossless-json": "^1.0.1",
    "@types/md5": "^2.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/semver": "^7.3.13",
    "@types/three": "^0.133.0",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.4.20",
    "babel-plugin-react-compiler": "^1.0.0",
    "check-disk-space": "^3.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crc": "^4.3.2",
    "decimal.js": "^10.3.1",
    "electron": "^43.1.1",
    "electron-builder": "^25.1.8",
    "electron-log": "^5.4.4",
    "electron-vite": "6.0.0-beta.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "filtrex": "^3.1.0",
    "fs-extra": "^10.1.0",
    "hash-wasm": "^4.12.0",
    "json5": "^2.2.3",
    "klaw": "^4.1.0",
    "lodash.isequal": "^4.5.0",
    "lodash.mergewith": "^4.6.2",
    "lossless-json": "^1.0.5",
    "lucide-react": "^0.475.0",
    "md5": "^2.3.0",
    "postcss": "^8.5.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0",
    "rfc6902": "^5.0.1",
    "semver": "^7.8.5",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.133.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^8.1.5",
    "zustand": "^5.0.3"
  }
}
