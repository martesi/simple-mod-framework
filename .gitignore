# Compiled Lingui catalogs - @lingui/vite-plugin compiles messages.po on the fly (dev-server
# request time / bundled at build time, see electron.vite.config.ts), so this is never meant to
# exist on disk as a checked-in file; messages.po is the only catalog artifact that's source of
# truth.
src/renderer/src/locales/**/messages.mjs

# scripts/fetch-win-electron.ts's extraction target - see bun run dev:win.
/.win-electron-dev
/.win-electron-dev-*

# extra/Third-Party/ contains the tools the embedded framework core needs at runtime. Most of the
# release-backed files are ignored below and fetched by scripts/fetch-third-party.ts; the few tools
# without a confirmed public release remain tracked as regular blobs. Don't ignore the whole
# directory here - that would stop git from tracking the files that ARE meant to be committed too.
#
# The tools below, in that same folder, are the opposite: ones that DO have a
# stable public release to pull from, so scripts/fetch-third-party.ts
# downloads them straight into extra/Third-Party instead of duplicating them
# in git history. Ignored individually by name (rather than the whole
# directory) since they sit alongside the committed tools above.
7z.exe
.wineprefix
HMLanguageTools.exe
HMTextureTools.exe
quickentity-3.exe
quickentity-rs.exe
rpkg-cli.exe
quickentity_ffi.dll
assimp.dll
hash_list.hmla
ResourceTool.exe
ResourceLib_HM2.dll
ResourceLib_HM2016.dll
ResourceLib_HM3.dll
xdelta3.exe
tests/mods
r/
