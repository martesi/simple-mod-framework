# Compiled Lingui catalogs - @lingui/vite-plugin compiles messages.po on the fly (dev-server
# request time / bundled at build time, see electron.vite.config.ts), so this is never meant to
# exist on disk as a checked-in file; messages.po is the only catalog artifact that's source of
# truth.
src/renderer/src/locales/**/messages.mjs

# scripts/fetch-win-electron.js's extraction target - see npm run dev:win.
/.win-electron-dev

# extra/Third-Party/ ships the tools the embedded framework core needs at
# runtime and is tracked in git as regular (in a couple of cases multi-MB)
# blobs - this repo is managed with jj, which as of writing doesn't support
# Git LFS or even .gitattributes at all (https://github.com/jj-vcs/jj/issues/80),
# so there's no way to avoid that. Tracking the larger files here needs
# `jj config set --repo snapshot.max-new-file-size "20MiB"` once per clone -
# jj's default 1MiB cap on new file snapshots will otherwise refuse them.
# Don't ignore the whole directory here - that would stop git from tracking
# the files that ARE meant to be committed too (gitignore doesn't look inside
# a directory it's already ignoring).
#
# The tools below, in that same folder, are the opposite: ones that DO have a
# stable public release to pull from, so scripts/fetch-third-party.js
# downloads them straight into extra/Third-Party instead of duplicating them
# in git history. Ignored individually by name (rather than the whole
# directory) since they sit alongside the committed tools above.
7z.exe
7z-real.exe
.wineprefix
HMLanguageTools.exe
HMTextureTools.exe
quickentity-rs.exe
tests/mods
.ref/
